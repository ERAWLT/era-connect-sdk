{
  "name": "@hwlt/era-connect",
  "version": "0.5.3",
  "description": "ERA hardware wallet SDK: air-gapped UR/QR account linking and transaction signing for EVM, Bitcoin (+ LTC/DOGE/DASH/BCH), Solana, Tron, TON, Cardano, Sui, Cosmos and XRP",
  "keywords": [
    "era-wallet",
    "hardware-wallet",
    "air-gap",
    "ur",
    "bc-ur",
    "qr",
    "keystone",
    "react-native",
    "bitcoin",
    "ethereum",
    "solana",
    "tron",
    "ton",
    "cardano",
    "sui",
    "cosmos",
    "xrp",
    "bitcoin-cash",
    "litecoin",
    "dogecoin"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ERAWLT/era-connect-sdk.git",
    "directory": "packages/connect"
  },
  "homepage": "https://github.com/ERAWLT/era-connect-sdk#readme",
  "bugs": "https://github.com/ERAWLT/era-connect-sdk/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "proto",
    "evm",
    "btc",
    "bch",
    "solana",
    "xrp",
    "cosmos",
    "sui",
    "cardano",
    "ton",
    "tron",
    "verify",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./evm": {
      "react-native": "./dist/evm.js",
      "import": {
        "types": "./dist/evm.d.ts",
        "default": "./dist/evm.js"
      },
      "require": {
        "types": "./dist/evm.d.cts",
        "default": "./dist/evm.cjs"
      }
    },
    "./btc": {
      "react-native": "./dist/btc.js",
      "import": {
        "types": "./dist/btc.d.ts",
        "default": "./dist/btc.js"
      },
      "require": {
        "types": "./dist/btc.d.cts",
        "default": "./dist/btc.cjs"
      }
    },
    "./bch": {
      "react-native": "./dist/bch.js",
      "import": {
        "types": "./dist/bch.d.ts",
        "default": "./dist/bch.js"
      },
      "require": {
        "types": "./dist/bch.d.cts",
        "default": "./dist/bch.cjs"
      }
    },
    "./solana": {
      "react-native": "./dist/solana.js",
      "import": {
        "types": "./dist/solana.d.ts",
        "default": "./dist/solana.js"
      },
      "require": {
        "types": "./dist/solana.d.cts",
        "default": "./dist/solana.cjs"
      }
    },
    "./tron": {
      "react-native": "./dist/tron.js",
      "import": {
        "types": "./dist/tron.d.ts",
        "default": "./dist/tron.js"
      },
      "require": {
        "types": "./dist/tron.d.cts",
        "default": "./dist/tron.cjs"
      }
    },
    "./ton": {
      "react-native": "./dist/ton.js",
      "import": {
        "types": "./dist/ton.d.ts",
        "default": "./dist/ton.js"
      },
      "require": {
        "types": "./dist/ton.d.cts",
        "default": "./dist/ton.cjs"
      }
    },
    "./cardano": {
      "react-native": "./dist/cardano.js",
      "import": {
        "types": "./dist/cardano.d.ts",
        "default": "./dist/cardano.js"
      },
      "require": {
        "types": "./dist/cardano.d.cts",
        "default": "./dist/cardano.cjs"
      }
    },
    "./sui": {
      "react-native": "./dist/sui.js",
      "import": {
        "types": "./dist/sui.d.ts",
        "default": "./dist/sui.js"
      },
      "require": {
        "types": "./dist/sui.d.cts",
        "default": "./dist/sui.cjs"
      }
    },
    "./cosmos": {
      "react-native": "./dist/cosmos.js",
      "import": {
        "types": "./dist/cosmos.d.ts",
        "default": "./dist/cosmos.js"
      },
      "require": {
        "types": "./dist/cosmos.d.cts",
        "default": "./dist/cosmos.cjs"
      }
    },
    "./xrp": {
      "react-native": "./dist/xrp.js",
      "import": {
        "types": "./dist/xrp.d.ts",
        "default": "./dist/xrp.js"
      },
      "require": {
        "types": "./dist/xrp.d.cts",
        "default": "./dist/xrp.cjs"
      }
    },
    "./verify": {
      "react-native": "./dist/verify.js",
      "import": {
        "types": "./dist/verify.d.ts",
        "default": "./dist/verify.js"
      },
      "require": {
        "types": "./dist/verify.d.cts",
        "default": "./dist/verify.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@scure/base": "^1.2.4",
    "@scure/bip32": "^1.6.2",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@ngraveio/bc-ur": "1.1.13",
    "@types/node": "^26.4.0",
    "cbor2": "^1.7.0",
    "fast-check": "^3.23.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
