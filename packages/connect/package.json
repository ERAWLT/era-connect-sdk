{
  "name": "@era-wallet/connect",
  "version": "0.1.0",
  "description": "ERA hardware wallet SDK: air-gapped UR/QR account linking and transaction signing for EVM, Bitcoin, Solana and Tron",
  "keywords": [
    "era-wallet",
    "hardware-wallet",
    "air-gap",
    "ur",
    "bc-ur",
    "qr",
    "keystone",
    "react-native",
    "bitcoin",
    "ethereum",
    "solana",
    "tron"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ERAWLT/era-connect-sdk.git",
    "directory": "packages/connect"
  },
  "homepage": "https://github.com/ERAWLT/era-connect-sdk#readme",
  "bugs": "https://github.com/ERAWLT/era-connect-sdk/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "sideEffects": false,
  "files": ["dist", "proto"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./evm": {
      "types": "./dist/evm.d.ts",
      "react-native": "./dist/evm.js",
      "import": "./dist/evm.js",
      "require": "./dist/evm.cjs"
    },
    "./btc": {
      "types": "./dist/btc.d.ts",
      "react-native": "./dist/btc.js",
      "import": "./dist/btc.js",
      "require": "./dist/btc.cjs"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "react-native": "./dist/solana.js",
      "import": "./dist/solana.js",
      "require": "./dist/solana.cjs"
    },
    "./tron": {
      "types": "./dist/tron.d.ts",
      "react-native": "./dist/tron.js",
      "import": "./dist/tron.js",
      "require": "./dist/tron.cjs"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "react-native": "./dist/verify.js",
      "import": "./dist/verify.js",
      "require": "./dist/verify.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@scure/base": "^1.2.4",
    "@scure/bip32": "^1.6.2",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@ngraveio/bc-ur": "1.1.13",
    "cbor2": "^1.7.0",
    "fast-check": "^3.23.2",
    "tsdown": "^0.12.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
